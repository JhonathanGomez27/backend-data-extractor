### Variables
@API_URL = http://52.5.255.229:3001
@TOKEN = your_jwt_token_here
@CLIENT_ID = 6a6c6c0c-a11d-45d7-84c9-c63d0aee0732
@MODEL_TYPE_ID = e3ebad38-cb97-4bf3-83e0-ccc229e599d1
@MODEL_ID = your_model_id_here

# Basic Auth credentials (username:password in base64)
@BASIC_AUTH = Basic Q2F0U2VydmVpczpDYXQxMjM0NTY3OA==


##################################################
### ADMIN ENDPOINTS (JWT Authentication)
##################################################

### 0. List Available AI Providers and Models
GET {{API_URL}}/api/models/ai-providers
Authorization: Bearer {{TOKEN}}


### 1. Create Model (Admin with Gemini)
POST {{API_URL}}/api/models
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
  "name": "Menciona la marca al contestar (Gemini)",
  "description": "Detectar si se menciona la marca del producto o servicio en la conversación.",
  "modelTypeId": "{{MODEL_TYPE_ID}}",
  "clientId": "{{CLIENT_ID}}",
  "provider": "gemini",
  "aiModel": "gemini-3.7-flash",
  "data": {
    "template": {
      "templateName": "deteccion_marca_producto_servicio",
      "modules": [
        {
          "key": "entidades",
          "enabled": true,
          "config": {
            "extraer": true,
            "tipos": [
              "marca"
            ],
            "reglas": {
              "debe_mencionarse": true,
              "ventana_inicial_segundos": 0,
              "coincidencia": {
                "modo": "parcial",
                "case_sensitive": false
              },
              "sinonimos": []
            }
          }
        }
      ]
    }
  } 
}


